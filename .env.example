# PayPal client id (public; sent to the browser)
Paypal_Client_2026=
# PayPal secret for the same app (server only; never expose it to the browser)
Paypal_secret_2026=
# PayPal REST API: https://api-m.sandbox.paypal.com (sandbox, the default) or
# https://api-m.paypal.com (live). Must match the client id and secret.
PAYPAL_API_BASE=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Store Sync cart API (pages/api/merchant-cart): "true" turns it on; anything
# else keeps every route a 404. Leave off until PayPal approves Store Sync.
STORE_SYNC_ENABLED=
# Where PayPal publishes the keys that sign Store Sync requests (from onboarding).
PAYPAL_JWKS_URL=
# Optional: the issuer and audience PayPal's Store Sync tokens must carry (from onboarding).
PAYPAL_JWT_ISSUER=
PAYPAL_JWT_AUDIENCE=
